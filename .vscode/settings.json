{
  "files.exclude": {
    "**/Library": true,
    "**/Temp": true,
    "**/Obj": true,
    "**/Logs": true,
    "**/*.csproj": true,
    "**/*.sln": true
  },
  "search.exclude": {
    "**/Library": true,
    "**/Temp": true,
    "**/Logs": true,
    "**/UserSettings": true
  },
  "files.associations": {
    "*.asmdef": "json"
  },
  "editor.rulers": [100],
  "[markdown]": {
    "editor.wordWrap": "on"
  }
}
